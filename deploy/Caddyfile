# Standalone example: replace the hostname and point the root at your static build.
# No backend proxy belongs here. Keep operator deployment configuration private.
gateway.example.com {
  header Cache-Control "no-store"
  header Referrer-Policy "no-referrer"
  header X-Content-Type-Options "nosniff"
  handle_path /__locho/* {
    root * /srv/openlia-locho/current
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; connect-src 'self' https://dns.iroh.link https://*.iroh.link wss://*.iroh.link; frame-ancestors 'none'; base-uri 'none'"
    @worker path /sw.js
    header @worker Service-Worker-Allowed "/"
    file_server
  }
  handle {
    @navigation {
      method GET HEAD
      header Sec-Fetch-Mode navigate
    }
    redir @navigation /__locho/ 302
    @root {
      method GET HEAD
      path / /__locho
    }
    redir @root /__locho/ 302
    respond "No public upstream fallback" 404
  }
}
