{
  "name": "openlia-locho",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "serve": "node scripts/serve.mjs",
    "release": "npm run check && node scripts/package-release.mjs",
    "verify:hosting": "node scripts/verify-hosting.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "locho_web": "0.1.0-beta.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
